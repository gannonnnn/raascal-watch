# Storage and watchlist
RW_DB_PATH=./data/raascal_watch.db
RW_WATCHLIST_PATH=./config/watchlist.yaml

# Scanning
RW_POLL_INTERVAL_MINUTES=15
RW_REQUEST_TIMEOUT_SECONDS=30
RW_MAX_PAGES_PER_SOURCE=100
RW_RUN_SCAN_ON_STARTUP=true
RW_ENABLE_KALSHI=true
RW_ENABLE_POLYMARKET=true

# The first successful scan establishes a silent baseline.
RW_ALERT_ON_FIRST_SCAN=false

# Alert only when a contract is newly observed by default.
RW_ALERT_ON_NEW_MATCH_FOR_EXISTING_MARKET=false

# Optional Slack incoming webhook
RW_SLACK_WEBHOOK_URL=

# Optional generic JSON webhook
RW_GENERIC_WEBHOOK_URL=

# Optional email configuration
RW_SMTP_HOST=
RW_SMTP_PORT=587
RW_SMTP_USERNAME=
RW_SMTP_PASSWORD=
RW_SMTP_FROM=
RW_SMTP_TO=
RW_SMTP_USE_TLS=true
